// AgriBridge Prisma schema (PostgreSQL)
// One user → multiple roles (Admin, Farmer, Retailer, Consumer)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  phone     String?    @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  roles     UserRole[]
  products  Product[]  @relation("UserProducts")
  carts     CartItem[]
  wishlists WishlistItem[]
  reviews   Review[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     // ADMIN | FARMER | RETAILER | CONSUMER
  status    VerificationStatus @default(PENDING) // PENDING | APPROVED | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Verification & address (expand later: docs, bank, geo)
  verificationData Json?
  address          Json?

  @@unique([userId, role])
  @@index([userId])
  @@index([role, status])
}

enum Role {
  ADMIN
  FARMER
  RETAILER
  CONSUMER
}

enum VerificationStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// ====== CATALOG & COMMERCE MODELS ======

model Product {
  id          String   @id @default(uuid())
  name        String
  brand       String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  description String
  discountPercent Int?
  packSizes      Json?

  // Homepage section flags
  isTodayOffer   Boolean @default(false)
  isNewArrival   Boolean @default(false)
  isTrending     Boolean @default(false)

  // Category system
  mainCategory MainCategory
  subCategory  String

  // For Organic special rule (optional)
  organicType   OrganicType?
  organicDetail String?

  status  ProductStatus @default(PENDING) // PENDING → ADMIN_APPROVAL
  seller  User          @relation("UserProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String

  media      ProductMedia[]
  reviews    Review[]
  carts      CartItem[]
  wishlists  WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mainCategory, subCategory])
  @@index([isTodayOffer])
  @@index([isNewArrival])
  @@index([isTrending])
  @@index([status])
  @@index([sellerId])
}

model ProductMedia {
  id        String        @id @default(uuid())
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      MediaType
  url       String

  createdAt DateTime @default(now())

  @@index([productId])
}

model CartItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Review {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  rating Int    // 1–5 (enforce in application)
  text   String

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId, productId])
}

enum MainCategory {
  SEEDS
  CROP_PROTECTION
  CROP_NUTRITION
  EQUIPMENTS
  ANIMAL_HUSBANDRY
  ORGANIC
}

enum OrganicType {
  BIO_PESTICIDE
  CROP_NUTRITION
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

/// ====== APPLICATION & CONSULTATION MODELS ======

model LoanApplication {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  type        String   // "Tractor" | "Harvester"
  loanAmount  Decimal? @db.Decimal(12, 2)
  income      Decimal? @db.Decimal(12, 2)
  landSize    String?
  emi         Decimal? @db.Decimal(12, 2)
  
  status      ApplicationStatus @default(NEW)
  isRead      Boolean           @default(false)
  
  userId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([isRead])
}

model SpecialistConsultation {
  id        String   @id @default(uuid())
  name      String
  phone     String
  cropType  String?
  
  status    ApplicationStatus @default(NEW)
  isRead    Boolean           @default(false)
  
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([isRead])
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  APPROVED
  REJECTED
  COMPLETED
}
